---
import Container from "@/components/container.astro";
import { headerStyle } from "@/config/brand";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  {
    title: "Team",
    path: "/team",
  },
  {
    title: "Records",
    path: "/records",
  },
  {
    title: "Social Network",
    path: "/social-network",
  },
  {
    title: "Contact",
    path: "/contact",
  },
];

interface Props {
  blend?: boolean;
}

const { blend = false } = Astro.props;
const logoHeader = headerStyle === "logo";
---

{
  logoHeader ? (
    <header class:list={["relative", !blend && "border-b-4 border-[#e40e16]"]}>
      <Astronav>
        <div class="bg-[linear-gradient(180deg,#e03d04_0%,#e54e07_10%,#e86a04_25%,#ef9206_50%,#f5b106_75%,#f8be05_90%,#f7c506_100%)]">
          <Container>
            <div class="flex items-center justify-between">
              <a href="/" class="shrink-0" aria-label="The Academy of Speed">
                <img
                  src="/brand/academy-of-speed-logo.jpg"
                  alt="The Academy of Speed"
                  width="790"
                  height="444"
                  class="h-20 w-auto sm:h-24"
                />
              </a>
              <div class="block lg:hidden">
                <MenuIcon class="w-4 h-4 text-black" />
              </div>
            </div>
          </Container>
        </div>
        <div class="w-full bg-[#f7c506] lg:pointer-events-none lg:absolute lg:inset-0 lg:flex lg:items-center lg:bg-transparent">
          <Container class="lg:pointer-events-none lg:flex lg:justify-end">
            <MenuItems class="hidden w-full lg:pointer-events-auto lg:flex lg:w-auto">
              <ul class="flex flex-col lg:flex-row lg:gap-3">
                {menuitems.map((item) => (
                  <li>
                    <a
                      href={item.path}
                      class="flex py-2 items-center font-semibold text-black hover:text-[#e40e16] lg:px-3">
                      <span>{item.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </MenuItems>
          </Container>
        </div>
      </Astronav>
    </header>
  ) : (
    <header>
      <Container>
        <div class="flex flex-col lg:flex-row justify-between items-center my-5">
          <Astronav>
            <div class="flex w-full lg:w-auto items-center justify-between">
              <a href="/" class="text-lg">
                <span class="font-bold text-slate-800">Academy</span>
                <span class="text-slate-500">OfSpeed</span>
              </a>
              <div class="block lg:hidden">
                <MenuIcon class="w-4 h-4 text-gray-800" />
              </div>
            </div>
            <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
              <ul class="flex flex-col lg:flex-row lg:gap-3">
                {menuitems.map((item) => (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 items-center text-gray-600 hover:text-gray-900">
                      <span>{item.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </MenuItems>
          </Astronav>
        </div>
      </Container>
    </header>
  )
}
