---
import Link from "./ui/link.astro";
---

<div
  class="bg-black p-8 md:px-20 md:py-20 mt-20 mx-auto max-w-5xl rounded-lg flex flex-col items-center text-center">
  <h2 class="text-white text-4xl md:text-6xl tracking-tight">
   Ready to Run With Us?
  </h2>
  <p class="text-slate-400 mt-4 text-lg md:text-xl">
    Join Academy of Speed and become part of a team that trains with purpose, supports each other and strives to get better every day.
Whether you're chasing your next PB or starting your running journey, there's a place for you here.
  </p>
  <div class="flex mt-5">
    <Link href="/contact" style="inverted">Contact</Link>
  </div>
</div>
