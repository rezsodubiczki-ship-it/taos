---
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Track Training",
    description:
      "Structured track sessions designed to develop speed, endurance and race-specific fitness. From intervals and tempo work to race preparation, every session has a clear purpose and helps you become a faster, more efficient runner.",
    icon: "stadium-outline",
  },
  {
    title: "Cross Country",
    description:
      "Build strength, endurance and resilience on varied terrain and challenging courses. Cross country training develops the ability to adapt to hills, surfaces and changing conditions while building the strength needed to perform when racing gets tough.",
    icon: "tree",
  },
  {
    title: "Sprint Training",
    description:
      "Develop explosive speed, running mechanics and power through focused sprint training. We work on acceleration, technique and speed to help every athlete run more efficiently and unlock their full potential.",
    icon: "run",
  }
];
---

<div class="mt-16 pb-16 md:mt-0 max-w-3xl">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    Academy of Speed
  </h2>
  <p class="text-sm font-medium tracking-wide uppercase text-slate-500 mt-3">
    Established in 2012
  </p>
  <div class="mt-6 space-y-5 text-lg leading-relaxed text-slate-600">
    <p>
      Academy of Speed has established a proud record of achievement, including four Australian champions, 22 state records broken and numerous state medals across multiple events and age groups.
    </p>
    <p>
      Our success continued in 2026, with our athletes winning an outstanding 30 state medals, including 14 gold medals in a single season.
    </p>
    <p>
      What makes these achievements particularly special is that Academy of Speed has always operated as a small squad, with no more than 20 athletes in any given year. Our focus has never been on numbers, but on commitment, consistency and developing each athlete to their full potential.
    </p>
    <p>
      I believe talent is important, but hard work, discipline and resilience are what turn potential into performance. Every personal best, record and medal reflects the dedication and determination our athletes bring to their training.
    </p>
    <p>
      After 14 years, I remain passionate about developing dedicated athletes, producing champions and helping runners discover what they are capable of achieving.
    </p>
  </div>
  <p class="mt-8 text-xl font-semibold text-gray-800">
    Small squad. Big ambitions. Proven results.
  </p>
  <div class="mt-8">
    <p class="font-semibold text-gray-800">Brad Schofield</p>
    <p class="text-slate-500">Head Coach | Academy of Speed</p>
  </div>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 gap-16">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
