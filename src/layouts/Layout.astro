---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";

export interface Props {
  title: string;
}

const site = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL("/opengraph.jpg", site).toString();

const { title } = Astro.props;

const siteName = "Academy of Speed";
const description =
  "Academy of Speed is a community of runners driven to improve, compete and reach their full potential. Expert coaching, purposeful training, and a team that pushes each other forward.";
const makeTitle = title ? `${title} | ${siteName}` : `${siteName} — Run Faster Together`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={makeTitle}
      description={description}
      canonical={canonicalURL}
      twitter={{
        site: siteName,
        card: "summary_large_image",
      }}
      extend={{
        meta: [
          { name: "twitter:title", content: makeTitle },
          { name: "twitter:description", content: description },
          { name: "twitter:image", content: ogImage },
        ],
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: makeTitle,
          image: ogImage,
        },
        optional: {
          description,
          siteName,
        },
        image: {
          alt: "Academy of Speed athletes racing on the track",
          width: 1200,
          height: 630,
        },
      }}
    />
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
