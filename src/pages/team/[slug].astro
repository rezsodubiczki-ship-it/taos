---
import { getCollection, render } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";

export async function getStaticPaths() {
  const teamMembers = await getCollection("team", ({ data }) => {
    return !data.draft;
  });

  return teamMembers.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.name}>
  <Container>
    <div class="flex flex-col items-center text-center mt-16">
      <Picture
        src={entry.data.run}
        alt={`${entry.data.name} running`}
        widths={[480, 800, 1200]}
        sizes="(max-width: 768px) 90vw, 448px"
        width={800}
        height={1067}
        quality={90}
        formats={["webp", "jpg"]}
        class="w-full max-w-md rounded-sm object-cover object-center aspect-[3/4] bg-white"
      />
      <h1 class="mt-6 text-3xl lg:text-4xl font-bold text-gray-800">
        {entry.data.name}
      </h1>
    </div>

    <div class="mx-auto max-w-2xl mt-12 mb-20">
      <section>
        <h2 class="text-xl font-semibold text-gray-800">Coach's notes</h2>
        <div class="mt-3 text-lg leading-relaxed text-slate-600 prose prose-slate max-w-none">
          <Content />
        </div>
      </section>

      <section class="mt-12">
        <h2 class="text-xl font-semibold text-gray-800">
          Best competition results
        </h2>
        {
          entry.data.bestResults && entry.data.bestResults.length > 0 && (
            <ul class="mt-4 divide-y divide-slate-200 border-t border-b border-slate-200">
              {entry.data.bestResults.map((item) => (
                <li class="py-4 text-lg leading-relaxed text-slate-600">{item}</li>
              ))}
            </ul>
          )
        }
      </section>

      <section class="mt-12">
        <h2 class="text-xl font-semibold text-gray-800">Personal bests</h2>
        {
          entry.data.personalBests && entry.data.personalBests.length > 0 && (
            <ul class="mt-4 grid sm:grid-cols-3 gap-4">
              {entry.data.personalBests.map((item) => (
                <li class="rounded-md border border-slate-200 px-4 py-4 text-center">
                  <p class="text-lg leading-relaxed text-slate-600">
                    {item.event}
                  </p>
                  <p class="mt-1 text-lg leading-relaxed text-slate-600">
                    {item.time}
                  </p>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <div class="text-center mt-12">
        <a
          href="/team"
          class="bg-gray-100 px-5 py-3 rounded-md hover:bg-gray-200 transition"
          >← Back to Team</a
        >
      </div>
    </div>
  </Container>
</Layout>
