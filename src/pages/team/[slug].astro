---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";

export async function getStaticPaths() {
  const teamMembers = await getCollection("team", ({ data }) => {
    return !data.draft;
  });

  return teamMembers.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.name}>
  <Container>
    <div class="flex flex-col items-center text-center mt-16">
      <Picture
        src={entry.data.avatar}
        alt={entry.data.name}
        widths={[400, 800]}
        sizes="(max-width: 800px) 90vw, 480px"
        width={800}
        height={800}
        class="w-full max-w-md rounded-sm object-cover object-center aspect-square bg-white"
      />
      <h1 class="mt-6 text-3xl lg:text-4xl font-bold text-gray-800">
        {entry.data.name}
      </h1>
      <p class="mt-2 text-slate-500">{entry.data.title}</p>
      <p class="mt-1 text-sm text-slate-400">Born {entry.data.birthYear}</p>
    </div>

    <div class="mx-auto max-w-2xl mt-12 mb-20">
      <section>
        <h2 class="text-xl font-semibold text-gray-800">Coach's notes</h2>
        <div class="mt-3 text-lg leading-relaxed text-slate-600 prose prose-slate max-w-none">
          <Content />
        </div>
      </section>

      <section class="mt-12">
        <h2 class="text-xl font-semibold text-gray-800">
          Best competition results
        </h2>
        <ul class="mt-4 divide-y divide-slate-200 border-t border-b border-slate-200">
          {
            entry.data.bestResults.map((item) => (
              <li class="py-4 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                <div>
                  <p class="font-medium text-gray-800">{item.event}</p>
                  <p class="text-sm text-slate-500">
                    {item.year} · {item.competition}
                  </p>
                </div>
                <p class="text-slate-700 sm:text-right">{item.result}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-12">
        <h2 class="text-xl font-semibold text-gray-800">Personal bests</h2>
        <ul class="mt-4 grid sm:grid-cols-3 gap-4">
          {
            entry.data.personalBests.map((item) => (
              <li class="rounded-md border border-slate-200 px-4 py-4 text-center">
                <p class="text-sm text-slate-500">{item.event}</p>
                <p class="mt-1 text-xl font-semibold text-gray-800">
                  {item.time}
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      <div class="text-center mt-12">
        <a
          href="/team"
          class="bg-gray-100 px-5 py-3 rounded-md hover:bg-gray-200 transition"
          >← Back to Team</a
        >
      </div>
    </div>
  </Container>
</Layout>
