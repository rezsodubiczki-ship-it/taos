---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { getFacebookPageUrl } from "@/lib/facebook";
import { Icon } from "astro-icon/components";

const facebookPageUrl = getFacebookPageUrl();
---

<Layout title="Social Network">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Social Network</Fragment>
      <Fragment slot="desc">
        Follow Academy of Speed on Facebook for the latest updates.
      </Fragment>
    </Sectionhead>
    <main class="mt-16 mb-20">
      <div class="max-w-xl mx-auto text-center rounded-lg border border-slate-200 px-6 py-12">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-[#1877F2] text-white">
          <Icon name="uil:facebook-f" class="w-6 h-6" />
        </div>
        <h2 class="mt-5 text-2xl font-semibold text-gray-800">
          Brad Schofield on Facebook
        </h2>
        <p class="mt-3 text-slate-500 leading-relaxed">
          Facebook does not allow a personal profile timeline to be embedded
          on a website. Open the profile for the latest posts, or send a
          Facebook Page URL if you want the last 5 posts to appear here.
        </p>
        <a
          href={facebookPageUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex mt-6 items-center justify-center rounded-md bg-[#1877F2] px-5 py-3 text-white font-medium hover:bg-[#166fe5] transition">
          Open Facebook
        </a>
      </div>
    </main>
  </Container>
</Layout>
